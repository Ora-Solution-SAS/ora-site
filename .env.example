# ─────────────────────────────────────────────────────────────────────────────
# Service de réservation — variables d'environnement
#
# En PRODUCTION : Vercel > Project Settings > Environment Variables.
# En LOCAL      : copier ce fichier en `.env.local` (ignoré par git).
#
# ⚠ AUCUNE de ces valeurs ne doit être commitée, ni collée dans un ticket, ni
#   passée par messagerie. Elles ouvrent l'agenda et la boîte mail.
#
# Sans CALDAV_USERNAME / CALDAV_PASSWORD, le service tourne en MODE
# DÉMONSTRATION : il fabrique des créneaux, le dit à l'écran, et refuse
# d'enregistrer quoi que ce soit.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. L'agenda (obligatoire) ────────────────────────────────────────────────
# Infomaniak > Manager > Mot de passe d'application (obligatoire si la 2FA est
# active sur le compte ; sinon le mot de passe du compte fonctionne aussi).
# Assistant : https://config.infomaniak.com
CALDAV_URL=https://sync.infomaniak.com
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Facultatif : force une collection précise au lieu de la découverte
# automatique. À ne renseigner que si le mauvais agenda est choisi.
# CALDAV_CALENDAR_PATH=/calendar/xxxx/yyyy/

# ── 2. La visio kMeet (facultatif, recommandé) ───────────────────────────────
# Manager Infomaniak > Développement > Jetons API.
# L'identifiant d'agenda se lit avec ce même jeton :
#   curl -H "Authorization: Bearer $TOKEN" https://calendar.infomaniak.com/api/pim/calendar
# Sans ces deux valeurs, chaque rendez-vous reçoit une salle kMeet ouverte à
# l'URL (ou FALLBACK_MEETING_URL si elle est posée).
INFOMANIAK_API_TOKEN=
INFOMANIAK_CALENDAR_ID=
# FALLBACK_MEETING_URL=https://kmeet.infomaniak.com/votre-salle-fixe

# ── 3. Les courriels (facultatif, fortement recommandé) ──────────────────────
# Brevo > SMTP & API > Clés API. Le domaine ora-solution.com porte déjà un
# code Brevo dans son DNS, le compte existe donc.
# Sans clé, le rendez-vous est bien enregistré mais personne n'est prévenu :
# l'écran de confirmation le dit alors au visiteur.
BREVO_API_KEY=
# BREVO_FROM_EMAIL=raphael.gaugain@ora-solution.com
# BREVO_FROM_NAME=Ora Solution

# ── 4. Identité (facultatif) ─────────────────────────────────────────────────
# ORGANISER_EMAIL=raphael.gaugain@ora-solution.com
# ORGANISER_NAME=Raphael Gaugain

# ── 5. Les règles du rendez-vous (facultatif) ────────────────────────────────
# BOOKING_TIMEZONE=Europe/Paris
# BOOKING_DURATION_MIN=30
# BOOKING_STEP_MIN=30
# BOOKING_BUFFER_MIN=15
# BOOKING_MIN_NOTICE_H=12
# BOOKING_HORIZON_DAYS=30
# Plages ouvrables : « jours:plage,plage ; jours:plage ». 1 = lundi, 0 =
# dimanche. Par défaut, du lundi au vendredi, 9 h - 12 h 30 et 14 h - 18 h.
# BOOKING_OPENING_HOURS=1-5:09:00-12:30,14:00-18:00

# ── 6. L'interrupteur de la réservation en ligne ─────────────────────────────
# ⚠ FERMÉ PAR DÉFAUT. Tant que cette variable ne vaut pas exactement « true »,
# la fenêtre affiche « la prise de rendez-vous ouvre bientôt » et le bouton
# d'écriture directe, sans jamais appeler le service.
# À poser en MÊME TEMPS que les identifiants CalDAV, jamais avant : ouverte
# sans agenda branché, la fenêtre tomberait sur le mode démonstration.
# ⚠ Vite fige cette valeur à la COMPILATION : la changer dans Vercel exige un
# redéploiement, pas seulement un enregistrement.
VITE_BOOKING_ENABLED=false
